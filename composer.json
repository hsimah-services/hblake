{
  "name": "hsimah-services/hsimah",
  "type": "project",
  "require": {
    "php": ">=8.3",
    "ext-mbstring": "*",
    "ext-pdo_sqlite": "*",
    "elephentity/codegen-tsquid": "^0.1",
    "elephentity/graphql": "0.2.0-alpha.1",
    "elephentity/runtime": "0.13.1",
    "elephentity/sqlite": "0.1.0-alpha.5",
    "psr/container": "^2.0",
    "psr/log": "^3.0"
  },
  "require-dev": {
    "elephentity/cli": "0.13.1",
    "elephentity/codegen": "^0.6.1",
    "elephentity/codegen-php": "0.7.0",
    "elephentity/codegen-sqlite": "0.1.0-alpha.3",
    "elephentity/codegen-graphql-php": "0.1.0-alpha.3",
    "phpstan/phpstan": "^2.0",
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "Hsimah\\": "server/src/",
      "Hsimah\\Entity\\": "generated/",
      "Hsimah\\Type\\": "generated/Type/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Hsimah\\Tests\\": "server/tests/"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "config": {
    "sort-packages": true
  }
}
