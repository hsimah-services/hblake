{
  "name": "hsimah-client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsquid-relay persist && tsc --noEmit && vite build",
    "preview": "vite preview",
    "relay": "tsquid-relay persist",
    "relay:watch": "tsquid-relay persist --watch",
    "routes": "tsquid-codegen routes.json src/routes/__generated__/routes.ts",
    "routes:check": "tsquid-codegen routes.json src/routes/__generated__/routes.ts --check",
    "schema": "tsquid-schema fetch --endpoint \"${GRAPHQL_SCHEMA_ENDPOINT:-${BASE_URL:-http://localhost:8080}/graphql}\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0 && tsquid-check-architecture",
    "lint:fix": "eslint src --fix --max-warnings 0 && tsquid-check-architecture",
    "check": "pnpm lint && pnpm build",
    "test": "pnpm check",
    "schema:check": "tsquid-schema check --from ../.cache/server-schema.graphql",
    "relay:check": "tsquid-relay check"
  },
  "dependencies": {
    "@astryxdesign/core": "0.6.0",
    "@astryxdesign/theme-neutral": "0.6.0",
    "@stylexjs/stylex": "^0.19.0",
    "@tsquid/routes": "0.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-relay": "^21.0.1",
    "react-router": "^8.3.1",
    "rehype-sanitize": "^6.0.0",
    "relay-runtime": "^21.0.1"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.6.0",
    "@tsquid/codegen": "0.3.0",
    "@tsquid/eslint-plugin": "0.2.0",
    "@tsquid/vite": "0.1.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "babel-plugin-relay": "^21.0.1",
    "eslint": "^10.10.0",
    "relay-compiler": "^21.0.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.0"
  },
  "packageManager": "pnpm@12.11.2"
}
