{
  "runtime": "@tsquid/routes",
  "persistedQueries": "persisted_queries.json",
  "routes": [
    {
      "name": "Home",
      "entryPoint": "src/components/home/Home.entrypoint.ts",
      "path": "/",
      "fields": {},
      "query": "HomeQuery"
    },
    {
      "name": "Page",
      "entryPoint": "src/components/page/Page.entrypoint.ts",
      "path": "/pages/:slug",
      "fields": {
        "slug": {
          "kind": "string"
        },
        "after": {
          "kind": "string",
          "optional": true
        }
      },
      "query": "PageQuery"
    },
    {
      "name": "PageItem",
      "entryPoint": "src/components/page-item/PageItem.entrypoint.ts",
      "path": "/:page/:slug",
      "fields": {
        "page": {
          "kind": "string"
        },
        "slug": {
          "kind": "string"
        }
      },
      "query": "PageItemQuery"
    },
    {
      "name": "Login",
      "entryPoint": "src/components/login/Login.entrypoint.ts",
      "path": "/admin/login",
      "fields": {},
      "query": "LoginQuery"
    },
    {
      "name": "AdminHome",
      "entryPoint": "src/components/admin/Admin.entrypoint.ts",
      "path": "/admin",
      "fields": {},
      "query": "AdminQuery"
    },
    {
      "name": "AdminPageList",
      "entryPoint": "src/components/admin-page/AdminPage.entrypoint.ts",
      "path": "/admin/pages",
      "fields": {
        "after": {
          "kind": "string",
          "optional": true
        },
        "status": {
          "kind": "string",
          "optional": true
        },
        "q": {
          "kind": "string",
          "optional": true
        }
      },
      "query": "AdminPageListQuery"
    },
    {
      "name": "AdminPageCreate",
      "entryPoint": "src/components/admin-page/AdminPage.entrypoint.ts",
      "path": "/admin/pages/new",
      "fields": {},
      "query": "AdminPageCreateQuery"
    },
    {
      "name": "AdminPageDetail",
      "entryPoint": "src/components/admin-page/AdminPage.entrypoint.ts",
      "path": "/admin/pages/:id",
      "fields": {
        "id": {
          "kind": "string"
        }
      },
      "query": "AdminPageQuery"
    },
    {
      "name": "AdminPageEdit",
      "entryPoint": "src/components/admin-page/AdminPage.entrypoint.ts",
      "path": "/admin/pages/:id/edit",
      "fields": {
        "id": {
          "kind": "string"
        }
      },
      "query": "AdminPageQuery"
    },
    {
      "name": "AdminPageItemList",
      "entryPoint": "src/components/admin-page-item/AdminPageItem.entrypoint.ts",
      "path": "/admin/items/:page",
      "fields": {
        "page": {
          "kind": "string"
        },
        "after": {
          "kind": "string",
          "optional": true
        },
        "status": {
          "kind": "string",
          "optional": true
        },
        "q": {
          "kind": "string",
          "optional": true
        }
      },
      "query": "AdminPageItemListQuery"
    },
    {
      "name": "AdminPageItemCreate",
      "entryPoint": "src/components/admin-page-item/AdminPageItem.entrypoint.ts",
      "path": "/admin/items/:page/new",
      "fields": {
        "page": {
          "kind": "string"
        }
      },
      "query": "AdminPageItemCreateQuery"
    },
    {
      "name": "AdminPageItemDetail",
      "entryPoint": "src/components/admin-page-item/AdminPageItem.entrypoint.ts",
      "path": "/admin/items/:page/:id",
      "fields": {
        "page": {
          "kind": "string"
        },
        "id": {
          "kind": "string"
        }
      },
      "query": "AdminPageItemQuery"
    },
    {
      "name": "AdminPageItemEdit",
      "entryPoint": "src/components/admin-page-item/AdminPageItem.entrypoint.ts",
      "path": "/admin/items/:page/:id/edit",
      "fields": {
        "page": {
          "kind": "string"
        },
        "id": {
          "kind": "string"
        }
      },
      "query": "AdminPageItemQuery"
    },
    {
      "name": "AdminUserDetail",
      "entryPoint": "src/components/admin-user/AdminUser.entrypoint.ts",
      "path": "/admin/users/:id",
      "fields": {
        "id": {
          "kind": "string"
        }
      },
      "query": "AdminUserQuery"
    },
    {
      "name": "AdminUserEdit",
      "entryPoint": "src/components/admin-user/AdminUser.entrypoint.ts",
      "path": "/admin/users/:id/edit",
      "fields": {
        "id": {
          "kind": "string"
        }
      },
      "query": "AdminUserQuery"
    }
  ]
}
