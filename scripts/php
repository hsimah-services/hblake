#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
engine=$(command -v podman || command -v docker)
image=${HSIMAH_PHP_IMAGE:-localhost/hsimah-php:2}
if ! "$engine" image inspect "$image" >/dev/null 2>&1; then
  "$engine" build -t "$image" -f .docker/php.Dockerfile .docker
fi
mkdir -p .cache/composer .cache/cargo
exec "$engine" run --rm --network host -v "$PWD:/app:z" -w /app -e ADMIN_USERNAME -e ADMIN_PASSWORD -e ADMIN_DISPLAY_NAME -e BASE_URL -e HSIMAH_DATABASE -e COMPOSER_HOME=/app/.cache/composer -e CARGO_HOME=/app/.cache/cargo "$image" "$@"
