#!/usr/bin/env bash
# Runs a command in the Playwright .NET image (SDK, Chromium and fonts) with the repository mounted at /repo.
set -euo pipefail
cd "$(dirname "$0")/.."
ENGINE=${CONTAINER_ENGINE:-$(command -v podman || command -v docker)}
USER_ARGS=()
[ "$(basename "$ENGINE")" = docker ] && USER_ARGS=(--user "$(id -u):$(id -g)")
IMAGE=${HSIMAH_TEST_IMAGE:-mcr.microsoft.com/playwright/dotnet:v1.63.0-noble}
CACHE=${XDG_CACHE_HOME:-$HOME/.cache}/hsimah/nuget
mkdir -p "$CACHE"
exec "$ENGINE" run --rm "${USER_ARGS[@]}" --network host --ipc host -v "$PWD:/repo:z" -v "$CACHE:/nuget:z" -w /repo \
  -e NUGET_PACKAGES=/nuget -e DOTNET_CLI_HOME=/tmp -e DOTNET_NOLOGO=1 -e DOTNET_CLI_TELEMETRY_OPTOUT=1 -e HOME=/tmp \
  -e BASE_URL -e ADMIN_USERNAME -e ADMIN_PASSWORD -e ADMIN_DISPLAY_NAME -e REPO_ROOT=/repo \
  "$IMAGE" "$@"
