#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/../.."
ENGINE=$(command -v podman || command -v docker)
IMAGE=${HSIMAH_PHP_IMAGE:-localhost/hsimah-php:1}
STACK=hsimah-acceptance
export BASE_URL=${BASE_URL:-http://localhost:8080}
# The acceptance stack owns a separate database, so up/down never touch the local
# development database at the default .var/site.sqlite.
DATA=.var/acceptance
export HSIMAH_DATABASE=/app/$DATA/site.sqlite
start_stack() {
  local port
  port=$(python3 -c 'import os,urllib.parse; print(urllib.parse.urlparse(os.environ["BASE_URL"]).port or 8080)')
  "$ENGINE" run -d --stop-timeout 1 --name "$STACK" --network host -v "$PWD:/app:z" -w /app -e ADMIN_EMAIL -e ADMIN_PASSWORD -e ADMIN_DISPLAY_NAME -e BASE_URL -e HSIMAH_DATABASE "$IMAGE" php -S "0.0.0.0:$port" -t server/public server/public/router.php >/dev/null
  for attempt in {1..60}; do
    if python3 -c 'import os,urllib.request; urllib.request.urlopen(os.environ["BASE_URL"]+"/auth/csrf", timeout=1)' >/dev/null 2>&1; then return; fi
    sleep 0.5
  done
  "$ENGINE" logs "$STACK" >&2
  return 1
}
