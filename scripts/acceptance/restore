#!/usr/bin/env bash
source "$(dirname "$0")/common"
: "${1:?Backup path required}"
python3 - "$1" <<'PY'
import sqlite3,sys,tarfile,tempfile
from pathlib import Path
# Validate before stopping anything: a bad backup never takes the site down.
with tarfile.open(sys.argv[1]) as archive, tempfile.TemporaryDirectory() as work:
    names=archive.getnames()
    assert 'site.sqlite' in names and all(name=='site.sqlite' or name.startswith('media/') for name in names)
    archive.extract('site.sqlite', work, filter='data')
    with sqlite3.connect(f'file:{Path(work,"site.sqlite")}?mode=ro', uri=True) as db:
        assert db.execute('PRAGMA integrity_check').fetchone()[0]=='ok'
        assert db.execute('SELECT COUNT(*) FROM hsimah_user').fetchone()[0]==1
PY
"$ENGINE" rm -f "$STACK" >/dev/null
python3 - "$1" "$DATA" <<'PY'
import shutil,sys,tarfile,tempfile
from pathlib import Path
data=Path(sys.argv[2])
with tempfile.TemporaryDirectory() as work:
    with tarfile.open(sys.argv[1]) as archive:
        archive.extractall(work, filter='data')
    snapshot=Path(work,'site.sqlite')
    for name in ['site.sqlite-wal','site.sqlite-shm']:
        (data/name).unlink(missing_ok=True)
    shutil.copyfile(snapshot,data/'site.sqlite')
    (data/'site.sqlite').chmod(0o600)
    shutil.rmtree(data/'media', ignore_errors=True)
    media=Path(work,'media')
    if media.is_dir(): shutil.copytree(media,data/'media')
    else: (data/'media').mkdir()
    (data/'media').chmod(0o700)
PY
start_stack
