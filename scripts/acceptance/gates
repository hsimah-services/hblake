#!/usr/bin/env bash
# Every build gate: the compiler's formatting, validation, drift and contract checks, the C# build, formatting and unit tests, and the
# client's routes, Relay artifacts, lint, types and production build.
source "$(dirname "$0")/common"

scripts/eleph install
scripts/eleph install --check
scripts/eleph fmt
scripts/eleph validate spec
scripts/eleph generate --check

PROJECTS=(src/Hsimah.Server src/Hsimah.Server.Tests src/Hsimah.Contracts tests/Hsimah.Acceptance tests/Hsimah.Acceptance.Ops)
for project in "${PROJECTS[@]}"; do
  scripts/dotnet dotnet build "$project" --nologo -v quiet
  scripts/dotnet dotnet format "$project" --verify-no-changes --exclude src/Hsimah.Server/Generated
done
scripts/eleph check
scripts/dotnet dotnet run --no-build --project src/Hsimah.Server.Tests -- -noColor

scripts/node install --frozen-lockfile
scripts/node routes:check
scripts/node exec relay-compiler --validate
scripts/node relay:check
scripts/node lint
scripts/node exec tsc --noEmit
scripts/node build
